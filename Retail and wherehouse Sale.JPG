<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="627" viewBox="0 0 1200 627" role="img" aria-labelledby="title desc"><title id="title">Retail Sales Analytics Dashboard</title><desc id="desc">Dashboard thumbnail with activity KPIs, sales channel share, monthly activity, top category and SKU, and data coverage note.</desc>
<defs><linearGradient id="bg" x1="0" y1="0" x2="1" y2="1"><stop stop-color="#081726"/><stop offset="1" stop-color="#102f3b"/></linearGradient><linearGradient id="mint" x1="0" x2="1"><stop stop-color="#34d6a4"/><stop offset="1" stop-color="#72efc2"/></linearGradient><filter id="shadow" x="-.15" y="-.2" width="1.3" height="1.4"><feDropShadow dx="0" dy="8" stdDeviation="10" flood-color="#020810" flood-opacity=".28"/></filter></defs>
<rect width="1200" height="627" rx="24" fill="url(#bg)"/><circle cx="1100" cy="30" r="280" fill="#3de0b0" opacity=".045"/>
<!-- header -->
<text x="45" y="45" fill="#76ebc7" font-family="Arial,sans-serif" font-size="13" font-weight="700" letter-spacing="2.2">RETAIL INTELLIGENCE  /  PYTHON PROJECT</text><text x="45" y="82" fill="#f3f8fa" font-family="Arial,sans-serif" font-size="32" font-weight="800">Retail &amp; Warehouse Sales</text><text x="45" y="108" fill="#9db6c1" font-family="Arial,sans-serif" font-size="15">A 2020 snapshot across 30,000 records • 15,668 SKUs • 8 categories</text><rect x="1092" y="37" width="62" height="29" rx="14" fill="#193d48" stroke="#326472"/><text x="1123" y="56" text-anchor="middle" fill="#a8c8d2" font-family="Arial,sans-serif" font-size="13" font-weight="700">2020</text>
<!-- KPI cards -->
<g filter="url(#shadow)"><rect x="42" y="132" width="265" height="91" rx="15" fill="#122c3b" stroke="#244857"/><rect x="322" y="132" width="265" height="91" rx="15" fill="#122c3b" stroke="#244857"/><rect x="602" y="132" width="265" height="91" rx="15" fill="#122c3b" stroke="#244857"/><rect x="882" y="132" width="276" height="91" rx="15" fill="#122c3b" stroke="#244857"/></g>
<text x="62" y="159" fill="#91abb8" font-family="Arial,sans-serif" font-size="11" font-weight="700" letter-spacing="1.3">TOTAL ACTIVITY</text><text x="62" y="198" fill="#f2fafb" font-family="Arial,sans-serif" font-size="30" font-weight="800">1,228,939.61</text>
<text x="342" y="159" fill="#91abb8" font-family="Arial,sans-serif" font-size="11" font-weight="700" letter-spacing="1.3">WAREHOUSE SHARE</text><text x="342" y="198" fill="#54e2b5" font-family="Arial,sans-serif" font-size="30" font-weight="800">66.96%</text>
<text x="622" y="159" fill="#91abb8" font-family="Arial,sans-serif" font-size="11" font-weight="700" letter-spacing="1.3">TOP CATEGORY</text><text x="622" y="198" fill="#f2fafb" font-family="Arial,sans-serif" font-size="30" font-weight="800">BEER <tspan fill="#77cfff" font-size="19">66.12%</tspan></text>
<text x="902" y="159" fill="#91abb8" font-family="Arial,sans-serif" font-size="11" font-weight="700" letter-spacing="1.3">TOP SKU  ·  49,109.50</text><text x="902" y="189" fill="#f2fafb" font-family="Arial,sans-serif" font-size="16" font-weight="800">CORONA EXTRA LOOSE</text><text x="902" y="210" fill="#b6cbd3" font-family="Arial,sans-serif" font-size="14">NR - 12OZ</text>
<!-- channel panel -->
<g filter="url(#shadow)"><rect x="42" y="244" width="537" height="274" rx="17" fill="#102838" stroke="#244857"/><rect x="594" y="244" width="564" height="274" rx="17" fill="#102838" stroke="#244857"/></g>
<text x="66" y="276" fill="#eff6f8" font-family="Arial,sans-serif" font-size="16" font-weight="700">Activity by channel</text><text x="66" y="297" fill="#88a5b2" font-family="Arial,sans-serif" font-size="12">Share of the three channel totals</text>
<!-- stacked bar -->
<rect x="66" y="319" width="480" height="20" rx="10" fill="#233f4e"/><path d="M76 319H387V339H76a10 10 0 0 1-10-10 10 10 0 0 1 10-10Z" fill="url(#mint)"/><rect x="387" y="319" width="81" height="20" fill="#58bafa"/><path d="M468 319h68a10 10 0 0 1 10 10 10 10 0 0 1-10 10h-68Z" fill="#a98af6"/>
<circle cx="75" cy="372" r="5" fill="#4ce0b1"/><text x="88" y="377" fill="#c5d6dd" font-family="Arial,sans-serif" font-size="13">Warehouse sales</text><text x="534" y="377" text-anchor="end" fill="#f2fafb" font-family="Arial,sans-serif" font-size="13" font-weight="700">822,930.93  ·  66.96%</text>
<circle cx="75" cy="405" r="5" fill="#58bafa"/><text x="88" y="410" fill="#c5d6dd" font-family="Arial,sans-serif" font-size="13">Retail sales</text><text x="534" y="410" text-anchor="end" fill="#f2fafb" font-family="Arial,sans-serif" font-size="13" font-weight="700">208,186.94  ·  16.94%</text>
<circle cx="75" cy="438" r="5" fill="#a98af6"/><text x="88" y="443" fill="#c5d6dd" font-family="Arial,sans-serif" font-size="13">Retail transfers</text><text x="534" y="443" text-anchor="end" fill="#f2fafb" font-family="Arial,sans-serif" font-size="13" font-weight="700">197,821.74  ·  16.10%</text>
<rect x="66" y="467" width="480" height="31" rx="8" fill="#173745"/><text x="80" y="487" fill="#a7c2cc" font-family="Arial,sans-serif" font-size="11">Retail sales and transfers move closely together</text><text x="530" y="488" text-anchor="end" fill="#71e8c0" font-family="Arial,sans-serif" font-size="12" font-weight="700">r = 0.84</text>
<!-- month chart -->
<text x="618" y="276" fill="#eff6f8" font-family="Arial,sans-serif" font-size="16" font-weight="700">Monthly activity</text><text x="618" y="297" fill="#88a5b2" font-family="Arial,sans-serif" font-size="12">The supplied file includes four months</text>
<line x1="636" y1="448" x2="1128" y2="448" stroke="#355361"/><line x1="636" y1="400" x2="1128" y2="400" stroke="#203e4b" stroke-dasharray="4 6"/><line x1="636" y1="352" x2="1128" y2="352" stroke="#203e4b" stroke-dasharray="4 6"/>
<path d="M680 378 C740 386 765 412 805 414 S903 327 930 322 S1015 347 1050 348 S1100 434 1120 438" fill="none" stroke="url(#mint)" stroke-width="4" stroke-linecap="round"/><path d="M680 378 C740 386 765 412 805 414 S903 327 930 322 S1015 347 1050 348 S1100 434 1120 438 L1120 448 L680 448Z" fill="#54dfb4" opacity=".09"/>
<g fill="#60e8be" stroke="#102838" stroke-width="3"><circle cx="680" cy="378" r="6"/><circle cx="805" cy="414" r="6"/><circle cx="930" cy="322" r="6"/><circle cx="1050" cy="348" r="6"/><circle cx="1120" cy="438" r="6"/></g>
<text x="668" y="467" fill="#91adba" font-family="Arial,sans-serif" font-size="11" font-weight="700">JAN</text><text x="793" y="467" fill="#91adba" font-family="Arial,sans-serif" font-size="11" font-weight="700">MAR</text><text x="918" y="467" fill="#91adba" font-family="Arial,sans-serif" font-size="11" font-weight="700">JUL</text><text x="1038" y="467" fill="#91adba" font-family="Arial,sans-serif" font-size="11" font-weight="700">SEP</text>
<text x="618" y="493" fill="#71e8c0" font-family="Arial,sans-serif" font-size="12" font-weight="700">JULY</text><text x="657" y="493" fill="#9eb5bf" font-family="Arial,sans-serif" font-size="12">595,339.95</text><text x="809" y="493" fill="#ffad88" font-family="Arial,sans-serif" font-size="12" font-weight="700">SEPTEMBER</text><text x="889" y="493" fill="#9eb5bf" font-family="Arial,sans-serif" font-size="12">16,834.62</text>
<!-- bottom insight ribbon -->
<rect x="42" y="536" width="1116" height="62" rx="14" fill="#153341" stroke="#2a5660"/><rect x="42" y="536" width="5" height="62" rx="2" fill="#f5a36d"/><text x="64" y="560" fill="#ffbd91" font-family="Arial,sans-serif" font-size="11" font-weight="700" letter-spacing="1.1">DATA QUALITY</text><text x="64" y="581" fill="#d9e6ea" font-family="Arial,sans-serif" font-size="13">Supplier names were mistakenly cast to numbers in the notebook; supplier rankings are unreliable until corrected.</text><text x="1134" y="581" text-anchor="end" fill="#829eaa" font-family="Arial,sans-serif" font-size="11">SOURCE: 2020 • JAN / MAR / JUL / SEP</text>
</svg>